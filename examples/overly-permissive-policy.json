{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExampleOverlyBroadAccess",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "ExamplePublicBucketAccess",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::example-public-bucket/*"
    }
  ]
}
